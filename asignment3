using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;

namespace AssetManagementSystem
{
    // OOP: The Asset Class
    class Asset
    {
        public int AssetID { get; set; }
        public string AssetName { get; set; }
        public string Department { get; set; }
        public double Value { get; set; }

        // Constructor to initialize attributes
        public Asset(int id, string name, string dept, double val)
        {
            AssetID = id;
            AssetName = name;
            Department = dept;
            Value = val;
        }

        // Method to display asset details
        public void DisplayInfo()
        {
            Console.WriteLine($"[ID: {AssetID}] {AssetName,-15} | Dept: {Department,-10} | Value: ${Value:N2}");
        }

        // Helper to format data for file storage
        public override string ToString()
        {
            return $"{AssetID},{AssetName},{Department},{Value}";
        }
    }

    class Program
    {
        static void Main(string[] args)
        {
            string filePath = "assets.txt";

            // 1. Create a List of Asset objects
            List<Asset> assets = new List<Asset>
            {
                new Asset(101, "MacBook Pro", "IT", 75000),
                new Asset(102, "Office Desk", "HR", 12000),
                new Asset(103, "Dell Server", "IT", 120000),
                new Asset(104, "Ergo Chair", "Operations", 8000),
                new Asset(105, "Projector", "Marketing", 55000)
            };

            // 2. File Processing: Write to assets.txt
            try
            {
                using (StreamWriter writer = new StreamWriter(filePath))
                {
                    foreach (var asset in assets)
                    {
                        writer.WriteLine(asset.ToString());
                    }
                }
                Console.WriteLine("Data successfully saved to assets.txt.\n");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error saving file: {ex.Message}");
            }

            // 3. File Processing: Read and Display all records
            Console.WriteLine("--- All Assets from File ---");
            if (File.Exists(filePath))
            {
                string[] lines = File.ReadAllLines(filePath);
                foreach (string line in lines)
                {
                    Console.WriteLine(line);
                }
            }

            // 4. LINQ: Filter assets with value > 50,000
            var highValueAssets = assets.Where(a => a.Value > 50000).ToList();

            // 5. Call DisplayInfo() for filtered assets
            Console.WriteLine("\n--- High-Value Assets (Over 50,000) ---");
            highValueAssets.ForEach(a => a.DisplayInfo());

            Console.WriteLine("\nPress any key to exit...");
            Console.ReadKey();
        }
    }
}
